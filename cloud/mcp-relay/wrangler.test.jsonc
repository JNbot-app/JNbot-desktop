{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "INSTALLATIONS",
        "class_name": "InstallationRelay"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InstallationRelay"]
    }
  ]
}
