{
  "name": "jnbot",
  "productName": "jnbot",
  "description": "Minecraft bot program built for JartexNetwork & PikaNetwork",
  "version": "1.0.0",
  "types": "./src/main/index.d.ts",
  "main": "./src/main/main.ts",
  "scripts": {
    "build:needle": "node scripts/build-needle.mjs",
    "prepare:needle-mobile": "node scripts/prepare-needle-mobile.mjs",
    "start:cli": "cross-env NODE_ENV=development ./release/app/dist/cli/jnbot",
    "build": "npm run build:plugin-reference && concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "node esbuild/esbuild.config.main.prod.js",
    "build:renderer": "rm -rf ./release/app/dist/renderer && vite build --config src/renderer/vite.prod.config.ts",
    "build:types": "node scripts/build-jnbot-types.mjs",
    "build:plugin-reference": "node scripts/build-jnbot-types.mjs",
    "sync:plugin-reference": "node scripts/build-jnbot-types.mjs --external",
    "check:plugin-reference": "node scripts/build-jnbot-types.mjs --check --external",
    "build:cli": "node esbuild/esbuild.config.cli.prod.js",
    "build:mobile-backend": "node scripts/build-mobile-backend.mjs",
    "sync:mobile-client-contract": "node scripts/sync-mobile-client-contract.mjs",
    "check:mobile-client-contract": "node scripts/sync-mobile-client-contract.mjs --check",
    "build:mods": "bash ./minecraft-mods/jnbot-fabric/build.sh",
    "publish:mods": "node scripts/publishMods.mjs",
    "install:cli": "node scripts/install-cli.js",
    "cli": "node ./release/app/dist/cli/cli/cli.mjs",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "lint": "cross-env NODE_ENV=development eslint . --ext .js,.jsx,.ts,.tsx",
    "package": "rm -rf release/app/dist release/build && npm run build:mods && npm run build && electron-builder build --publish never",
    "package:cli": "npm run build:cli && mkdir -p release/build && (cd ./release/app/dist/cli && zip -r ../../../build/cli.zip .)",
    "fpack": "electron-builder build --publish never ",
    "postinstall": "patch-package && electron-builder install-app-deps",
    "start": "node scripts/start-dev.mjs",
    "start:main": "cross-env NODE_ENV=development electron ./release/app/dist/main/main.js",
    "start:renderer": "vite serve src/renderer --port 1212",
    "start:profile": "cross-env REACT_SCAN=true npm start",
    "test": "npm run test:bots && jest",
    "test:main": "jest --selectProjects main",
    "test:renderer": "jest --selectProjects renderer",
    "test:scripts": "node test/scripts/runScriptMatrix.js",
    "test:bots:core": "node test/protocol/run.js --core",
    "test:bots:scripts": "node test/protocol/run.js --scripts",
    "test:bots": "npm run test:bots:core && npm run test:bots:scripts && npm run test:scripts",
    "test:fixtures:import": "node test/protocol/import-recording.js",
    "test:all": "npm test",
    "release": "rm -rf release/app/dist release/build && npm run build:mods && npm run publish:mods && npm run build && npm run package:cli && electron-builder build -wlm -p always && npm run release:win-resources && npm run release:cli && npm run release:source && npm run release:publish",
    "release:beta": "rm -rf release/app/dist release/build && npm run build:mods && npm run build && npm run package:cli && electron-builder build -wlm -p always -c.publish.channel=beta -c.publish.releaseType=draft && npm run release:win-resources && npm run release:cli && npm run release:publish:beta",
    "release:publish": "gh release edit v$(node -p \"require('./release/app/package.json').version\") --repo usserwout/JNbot-updater --draft=false",
    "release:publish:beta": "npm run release:publish -- --prerelease",
    "release:win-resources": "node scripts/release-win-resources.mjs",
    "release:cli": "gh release upload v$(node -p \"require('./release/app/package.json').version\") ./release/build/cli.zip --repo usserwout/JNbot-updater --clobber",
    "release:source": "node scripts/upload-mobile-source.mjs",
    "frelease": "npm run package:cli && electron-builder build -wlm -p always && npm run release:win-resources && npm run release:cli && npm run release:publish",
    "frelease:beta": "electron-builder build -wlm -p always -c.publish.channel=beta -c.publish.releaseType=draft && npm run release:win-resources && npm run release:publish:beta",
    "generate-licenses": "node scripts/generate-licenses.js",
    "legal-check": "npx license-checker --summary",
    "typecheck:renderer": "tsc --project src/renderer/tsconfig.json --noEmit",
    "typecheck:main": "tsc --project src/main/tsconfig.json --noEmit",
    "typecheck:tools": "tsc --project tsconfig.tools.json --noEmit",
    "start:diagnostics": "cross-env SENTRY_DIAGNOSTICS=true npm start",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:main && npm run typecheck:tools",
    "export:flash": "node scripts/export-flash.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JNbot-app/JNbot-desktop.git"
  },
  "homepage": "https://github.com/JNbot-app/JNbot-desktop#readme",
  "bugs": {
    "url": "https://github.com/JNbot-app/JNbot-desktop/issues"
  },
  "build": {
    "productName": "JNbot",
    "appId": "jnbot",
    "asar": true,
    "asarUnpack": [
      "**\\*.{node,dll}",
      "**/node_modules/esbuild-wasm/esbuild.wasm"
    ],
    "files": [
      "dist",
      "node_modules",
      "package.json",
      "!dist/main/src/**"
    ],
    "afterSign": "scripts/notarize.js",
    "protocols": [
      {
        "name": "JNbot",
        "schemes": [
          "jnbot"
        ]
      }
    ],
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "./assets/needle/darwin-${arch}",
          "to": "./assets/needle/darwin-${arch}"
        }
      ],
      "fileAssociations": [
        {
          "ext": "jnp",
          "name": "JNbot",
          "description": "Open plugin",
          "role": "Editor"
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "extraResources": [
        {
          "from": "./assets/needle/win32-${arch}",
          "to": "./assets/needle/win32-${arch}"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game",
      "extraResources": [
        {
          "from": "./assets/needle/linux-${arch}",
          "to": "./assets/needle/linux-${arch}"
        }
      ]
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      {
        "from": "./assets",
        "to": "./assets",
        "filter": [
          "**/*",
          "!needle/*-*/**"
        ]
      },
      {
        "from": "./release/app/dist/main/src",
        "to": "./src"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "usserwout",
        "repo": "JNbot-updater",
        "releaseType": "draft"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "author": {
    "name": "usserwout",
    "email": "usserwout@gmail.com"
  },
  "contributors": [
    {
      "name": "usserwout",
      "email": "usserwout@gmail.com"
    }
  ],
  "license": "MIT",
  "keywords": [
    "jartex",
    "jnbot",
    "react",
    "jartexnetwork",
    "minecraft",
    "mineflayer",
    "bot"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.23.7",
